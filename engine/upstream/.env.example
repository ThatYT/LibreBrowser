# Required. Use a long, unique password; this file is safe to commit only with a placeholder.
MIRROR_ACCESS_PASSWORD=replace-with-a-long-random-password

# Local evaluation binds to loopback. Set a non-loopback address only behind HTTPS.
REMOTE_BROWSER_BIND=127.0.0.1
REMOTE_BROWSER_PORT=8080

# Optional stable HMAC keys. Empty values generate process-local keys on each gateway start.
# For long-lived production sessions, generate each independently with: openssl rand -hex 32
MIRROR_ACCESS_SECRET=
MIRROR_AUTH_SECRET=

# Used by the invite-link helper.
MIRROR_PUBLIC_ORIGIN=http://localhost:8080
