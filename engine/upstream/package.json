{
  "name": "remote-browser",
  "version": "0.1.0",
  "description": "Run Chromium remotely and rebuild its pages as a scriptless interactive mirror",
  "private": true,
  "license": "Apache-2.0",
  "author": "mystxcal",
  "keywords": [
    "remote-browser",
    "rrweb",
    "chromium",
    "semantic-dom",
    "cdp"
  ],
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.23.1 <23",
    "pnpm": "9.15.9"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.12",
      "find-my-way": "9.7.0",
      "fast-uri@3": "3.1.8",
      "fast-uri@4": "4.1.5",
      "nanoid@3": "3.3.18",
      "postcss": "8.5.23",
      "source-map-js": "1.2.2"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "check:rrweb": "node scripts/check-rrweb-versions.mjs",
    "test:p2-diff": "tsx --test scripts/mirror-diff/*.test.ts",
    "p2-diff:run": "tsx scripts/mirror-diff/index.ts",
    "p2-diff:oopif": "P2_DIFF_OOPIF=1 pnpm run p2-diff:run",
    "p2-diff:ci": "node scripts/p2-diff-ci.mjs default",
    "p2-diff:oopif:ci": "node scripts/p2-diff-ci.mjs oopif",
    "p2-diff": "pnpm run build && pnpm run p2-diff:run",
    "p2-diff:real": "pnpm run build && P2_DIFF_REAL_SITES=1 pnpm run p2-diff:run",
    "p2-resync:chaos": "tsx scripts/p2-resync-chaos.ts",
    "p2-resync:chaos:10m": "tsx scripts/p2-resync-chaos.ts --ten-minutes",
    "test:rtc-media": "tsx scripts/rtc-media-acceptance.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:compose": "bash scripts/compose-smoke.sh",
    "check:host": "bash scripts/check-host.sh",
    "bootstrap": "bash scripts/bootstrap.sh",
    "invite": "tsx scripts/invite.ts",
    "ci": "node scripts/check-rrweb-versions.mjs && pnpm run build && pnpm run typecheck && pnpm run test && pnpm run test:rtc-media && pnpm run test:p2-diff && pnpm run p2-diff:ci && pnpm run p2-diff:oopif:ci && pnpm run format:check",
    "dev": "pnpm -r --parallel --if-present run dev"
  },
  "devDependencies": {
    "playwright": "^1.48.0",
    "prettier": "^3.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^3.0.0"
  }
}
