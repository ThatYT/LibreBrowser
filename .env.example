# No public listener is created. Review docs/DEPLOYMENT.md before using Caddy.
LOCAL_PORT=8090
# Optional build-time workaround when Docker bridge DNS is unavailable:
BUILD_NETWORK=default
PUBLIC_ORIGIN=https://browser.home.libremedicine.org
# Actual immediate Caddy source address as seen inside app container; do not trust all networks.
TRUSTED_PROXY_CIDRS=127.0.0.1/32
# Pin an upstream digest after testing it. latest is development-only.
CHROMIUM_IMAGE=lscr.io/linuxserver/chromium:latest
BROWSER_MEMORY=2147483648
BROWSER_NANO_CPUS=2000000000
BROWSER_PIDS=512
# Required before internet deployment: include server/VPS public IPs and public management endpoints.
# Example syntax (replace with your actual addresses): EGRESS_DENY_CIDRS=1.2.3.4/32
EGRESS_DENY_CIDRS=

# Optional existing host v2rayA integration; review docs/DEPLOYMENT.md first.
# scripts/enable-v2raya.sh sets COMPOSE_FILE and recreates browsers/egress; profiles persist.
# COMPOSE_FILE=compose.yaml:compose.v2raya.yaml
# V2RAYA_HTTP_PROXY=http://127.0.0.1:20171

# Opt-in DOM rendering; build and test before adding compose.dom.yaml.
BROWSER_IDLE_MINUTES=10
# RENDERER_ORIGIN=https://render.browser.home.libremedicine.org
