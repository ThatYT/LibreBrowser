[Unit]
Description=LibreBrowser loopback FRP visitor
Wants=network-online.target
After=network-online.target frps.service
[Service]
Type=simple
DynamicUser=yes
LoadCredential=frpc.toml:/etc/frp/librebrowser-visitor.toml
ExecStart=/usr/local/bin/frpc-librebrowser -c %d/frpc.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=128M
TasksMax=64
[Install]
WantedBy=multi-user.target
